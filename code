@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun HomeScreen(bmi: Float, onNavigateToReportScanner: () -> Unit, onNavigateToSubscription: () -> Unit) {
    var aiResponse by remember { mutableStateOf<AiResponse?>(null) }
    var isLoading by remember { mutableStateOf(true) }
    val coroutineScope = rememberCoroutineScope()

    // When the BMI value changes, this LaunchedEffect will re-run.
    LaunchedEffect(key1 = bmi) {
        coroutineScope.launch {
            isLoading = true
            aiResponse = GeminiAiService.getPlanForBmi(bmi)
            isLoading = false
        }
    }

    Scaffold(
