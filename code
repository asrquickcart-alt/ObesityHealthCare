package com.example.obesityhealthcare

import android.content.Context
import android.content.res.Configuration
import androidx.activity.ComponentActivity
import com.example.obesityhealthcare.ui.utils.LanguageManager
import java.util.Locale

open class BaseActivity : ComponentActivity() {

    override fun attachBaseContext(newBase: Context) {
        // Load the saved language code. If it's null (first run), this will do nothing and use the device default.
        val languageCode = LanguageManager.getLanguage(newBase)
        val context = if (languageCode != null) {
            val locale = Locale(languageCode)
            Locale.setDefault(locale)

            val config = Configuration(newBase.resources.configuration)
            config.setLocale(locale)
            config.setLayoutDirection(locale)

            newBase.createConfigurationContext(config)
        } else {
            newBase
        }
        super.attachBaseContext(context)
    }
}

