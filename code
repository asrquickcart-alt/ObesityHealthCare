private fun getTempUri(context: Context): Uri {
    val file = File.createTempFile("temp_image", ".jpg", context.cacheDir)
    return FileProvider.getUriForFile(context, "${context.packageName}.provider", file)
}

@Composable
fun ReportScannerScreen() {
    var imageUri by remember { mutableStateOf<Uri?>(null) }
    var aiResponse by remember { mutableStateOf<AiResponse?>(null) }
    var isLoading by remember { mutableStateOf(false) }
    val context = LocalContext.current
    val coroutineScope = rememberCoroutineScope()

    val galleryLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent(),
        onResult = { uri ->
            if (uri != null) {
                imageUri = uri
                aiResponse = null
            }
        }
    )

    // A separate launcher for the camera result
    val cameraLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.TakePicture(),
        onResult = { success ->
            if (success) {
                // The image is saved to the temp URI we passed. We trigger analysis by updating the state.
                imageUri = imageUri // This seems redundant, but it re-triggers the LaunchedEffect
            }
        }
    )

    // This is the new, robust permission launcher
    val cameraPermissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission(),
        onResult = { isGranted ->
            if (isGranted) {
                // Permission was granted, NOW we create a URI and launch the camera
                val tempUri = getTempUri(context)
                imageUri = tempUri // We need this URI to read the image after capture
                cameraLauncher.launch(tempUri)
            } else {
                // Handle the case where the user denies the permission
            }
        }
    )

    LaunchedEffect(imageUri) {
        imageUri?.let {
            isLoading = true
            try {
                val bitmap = if (Build.VERSION.SDK_INT >= 28) {
                    val source = ImageDecoder.createSource(context.contentResolver, it)
                    ImageDecoder.decodeBitmap(source)
                } else {
                    MediaStore.Images.Media.getBitmap(context.contentResolver, it)
                }

                val image = InputImage.fromBitmap(bitmap, 0)
                val recognizer = TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS)

                recognizer.process(image)
                    .addOnSuccessListener { visionText ->
                        val recognizedText = visionText.text
                        if (recognizedText.isNotBlank()) {
                            coroutineScope.launch {
                                aiResponse = GeminiAiService.analyzeReport(recognizedText)
                                isLoading = false
                            }
                        } else {
                            isLoading = false
                        }
                    }
                    .addOnFailureListener { _ -> isLoading = false }
            } catch (e: Exception) {
                isLoading = false
            }
        }
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp)
            .verticalScroll(rememberScrollState()),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        if (imageUri == null) {
            // Initial state: show buttons to select an image
            Button(
                onClick = { cameraPermissionLauncher.launch(Manifest.permission.CAMERA) },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text(stringResource(R.string.scan_with_camera))
            }
            Spacer(modifier = Modifier.height(16.dp))
            Button(
                onClick = { galleryLauncher.launch("image/*") },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text(stringResource(R.string.choose_from_file))
            }
        } else {
            // An image is selected or captured
            if (isLoading) {
                CircularProgressIndicator()
            } else {
                aiResponse?.let { response ->
                    AiResponseView(response)
                }
            }
        }
    }
}

